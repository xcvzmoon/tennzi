{
  "name": "tennzi",
  "description": "",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run desktop dev",
    "build": "bun run desktop tauri:build",
    "fmt": "run-s oxc:fmt cargo:fmt",
    "fmt:check": "run-s oxc:fmt:check cargo:fmt:check",
    "lint": "run-s oxc:lint cargo:lint",
    "check": "run-s fmt fmt:check lint",
    "test": "run-s vitest:test cargo:test",
    "oxc:fmt": "oxfmt",
    "oxc:fmt:check": "oxfmt --check",
    "oxc:lint": "oxlint",
    "cargo:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "cargo:fmt:check": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check",
    "cargo:lint": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "cargo:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "cargo:build": "cargo build --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "cargo:clean": "cargo clean --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "cargo:clean:release": "cargo clean --release --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "vitest:test": "vitest run",
    "vitest:test:watch": "vitest",
    "vitest:test:verbose": "vitest run --reporter=verbose",
    "desktop": "bun --cwd apps/desktop"
  },
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.0",
      "typescript": "^7.0.2",
      "valibot": "^1.4.2"
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "lefthook": "^2.1.10",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
