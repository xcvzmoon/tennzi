# Postgres 15+, wal_level=logical, used by both the Nitro server and zero-cache
ZERO_UPSTREAM_DB="postgres://user:password@localhost:5432/tennzi"

# Where zero-cache should send queries/mutations for this Nitro server
ZERO_QUERY_URL="http://localhost:3001/api/zero/query"
ZERO_MUTATE_URL="http://localhost:3001/api/zero/mutate"
